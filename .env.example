# Copy this file to .env and fill in your Gmail credentials.
# Enable Google 2-Step Verification and generate an App Password first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-support-account@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM="Where & When Support <your-support-account@gmail.com>"

# Use your public app URL when deployed.
APP_BASE_URL=http://localhost:8000
