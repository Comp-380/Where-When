# Where-When API Configuration
# Copy this file to .env and configure your preferences:
#   cp .env.example .env

# ==============================================================================
# OPTION A: 100% FREE & ZERO CREDIT CARD REQUIRED
# ==============================================================================

# 1. OpenStreetMap Places (NO API KEY & NO CREDIT CARD NEEDED!)
# Set this to true to fetch real restaurants, cafes, and cinemas live from OpenStreetMap.
USE_OPENSTREETMAP_PLACES=true

# 2. Ticketmaster Discovery API (FREE - NO CREDIT CARD REQUIRED!)
# Sign up with just an email at https://developer.ticketmaster.com/
# Go to My Apps > Create App to get your free Consumer Key (5,000 free requests/day).
TICKETMASTER_API_KEY=

# ==============================================================================
# OPTION B: GOOGLE CLOUD (Optional - Requires credit/debit card for billing setup)
# ==============================================================================
# If set, Google Places API will be prioritized over OpenStreetMap.
GOOGLE_PLACES_API_KEY=
